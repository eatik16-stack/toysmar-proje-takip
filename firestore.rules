rules_version = '2';

// Toysmar Proje Takip — yetki kuralları.
// Kimin gireceği kurallarda değil, "allowed" koleksiyonunda tutulur.
// Kurallar yalnızca yeni bir modül ya da rol eklendiğinde yeniden yayınlanır.
// Roller js/roles.js dosyasındakilerle birebir aynı olmalı:
// yonetici, planlamaci, satis, sef, personel.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- yardımcılar -------------------------------------------------
    // E-posta ile şifreyle açılan hesaplar doğrulanana kadar giremez;
    // Google ile gelen adresler zaten doğrulanmış sayılır.
    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }
    function email()    { return request.auth.token.email.lower(); }
    function userRef()  { return /databases/$(database)/documents/allowed/$(email()); }

    // Yetkili = girmiş VE "allowed" listesinde kaydı olan kişi.
    function isAllowed() { return signedIn() && exists(userRef()); }

    function me()          { return get(userRef()).data; }
    function myRole()      { return me().get('role', 'personel'); }
    function myPersonId()  { return me().get('personId', ''); }
    function myDept()      { return me().get('dept', ''); }

    function hasRole(roles) { return isAllowed() && myRole() in roles; }

    function isAdmin()  { return hasRole(['yonetici']); }
    // Proje açan, atama ve termin değiştiren roller.
    function canPlan()  { return hasRole(['yonetici', 'planlamaci']); }
    // Teklif hazırlayan ve fiyat gören roller.
    function canSell()  { return hasRole(['yonetici', 'satis']); }

    // --- kimler girebilir --------------------------------------------
    // Herkes listeyi okuyabilir (ekranlarda isim göstermek için),
    // yalnızca yönetici değiştirebilir.
    match /allowed/{userEmail} {
      allow read:                   if isAllowed();
      allow create, update, delete: if isAdmin();
    }

    // --- erişim talepleri ---------------------------------------------
    // Kişi kendi talebini yalnızca bir kez bırakır: create sadece belge
    // yokken çalışır, update yalnızca yöneticide. Reddedilen bir talep
    // bu yüzden kendiliğinden tekrar açılamaz.
    // Tek belge okuma (get) ile koleksiyonu listeleme (list) ayrı tutulur:
    // listeleme yalnızca yöneticide.
    match /requests/{userEmail} {
      allow get:    if isAdmin() || (signedIn() && email() == userEmail);
      allow list:   if isAdmin();
      allow create: if signedIn()
                    && email() == userEmail
                    && !exists(userRef())
                    && request.resource.data.email == userEmail
                    && request.resource.data.status == 'bekliyor';
      allow update, delete: if isAdmin();
    }

    // --- katalog, departmanlar, personel ------------------------------
    match /config/{doc} {
      allow read:  if isAllowed();
      allow write: if isAdmin();
    }

    // --- projeler ------------------------------------------------------
    // Silme yalnızca yöneticide; uygulama normalde arşivler, silmez.
    match /projects/{doc} {
      allow read:           if isAllowed();
      allow create, update: if canPlan();
      allow delete:         if isAdmin();
    }

    // --- iş emirleri ----------------------------------------------------
    // Planlayan roller hepsine dokunur; şef kendi departmanının işlerine,
    // personel yalnızca kendisine atanmış işe.
    match /tasks/{doc} {
      allow read:   if isAllowed();
      allow create: if canPlan();
      allow update: if canPlan()
                    || (isAllowed() && myPersonId() != ''
                        && resource.data.get('assignee', '') == myPersonId())
                    || (hasRole(['sef']) && myDept() != ''
                        && resource.data.get('dept', '') == myDept());
      allow delete: if isAdmin();
    }

    // --- teklifler ------------------------------------------------------
    // Fiyatlar yalnızca satış rollerine açık. Gönderilmiş teklif silinmez,
    // iptal edilir; silme yalnızca hiç gönderilmemiş taslakta (yönetici hepsinde).
    match /quotes/{doc} {
      allow read, create, update: if canSell();
      allow delete: if isAdmin()
                    || (canSell() && resource.data.get('status', '') == 'taslak');
    }
    // Teklife eklenen yerleşim görseli (belge başına bir görsel).
    match /quoteFiles/{doc} {
      allow read, write: if canSell();
    }
    // Teklif ayarları, ürün kataloğu ve teklif numarası sayacı.
    match /sales/{doc} {
      allow read, write: if canSell();
    }

    // --- değişiklik günlüğü ---------------------------------------------
    // Salt ekleme: yazılan bir kayıt hiç kimse tarafından değiştirilemez
    // veya silinemez. "Veri kaybolmasın" güvencesi burada.
    match /log/{doc} {
      allow read:   if isAllowed();
      allow create: if isAllowed();
      allow update: if false;
      allow delete: if false;
    }
  }
}
