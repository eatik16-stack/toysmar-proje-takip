rules_version = '2';

// Toysmar Proje Takip — yetki kuralları.
// Kimin gireceği kurallarda değil, "allowed" koleksiyonunda tutulur.
// Kurallar yalnızca yeni bir modül ya da rol eklendiğinde yeniden yayınlanır.
// Roller js/roles.js dosyasındakilerle birebir aynı olmalı:
// yonetici, planlamaci, muhasebe, satis, sef, personel.
//
// Görünürlük (karar 6): yönetici, planlamacı, muhasebe ve satış her iş emrini
// okur; şef yalnızca departmanının, personel yalnızca bölümünün (bölümü yoksa
// departmanının) iş emirlerini. Herkes kendi açtığı ve kendine atanan işi okur.
// Uygulama bu kapsamda sorgular; kapsam dışı bir sorgu burada reddedilir.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- yardımcılar -------------------------------------------------
    // E-posta ile şifreyle açılan hesaplar doğrulanana kadar giremez;
    // Google ile gelen adresler zaten doğrulanmış sayılır.
    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }
    function email()    { return request.auth.token.email.lower(); }
    function userRef()  { return /databases/$(database)/documents/allowed/$(email()); }

    // Yetkili = girmiş VE "allowed" listesinde kaydı olan kişi.
    function isAllowed() { return signedIn() && exists(userRef()); }

    function me()          { return get(userRef()).data; }
    function myRole()      { return me().get('role', 'personel'); }
    function myPersonId()  { return me().get('personId', ''); }
    function myDept()      { return me().get('dept', ''); }
    function mySection()   { return me().get('section', ''); }

    function hasRole(roles) { return isAllowed() && myRole() in roles; }

    function isAdmin()  { return hasRole(['yonetici']); }
    // Proje açan, atama ve termin değiştiren roller.
    function canPlan()  { return hasRole(['yonetici', 'planlamaci']); }
    // Teklif hazırlayan ve fiyat gören roller.
    function canSell()  { return hasRole(['yonetici', 'satis']); }
    // Muhasebe bilgilerini okuyan ve yazan roller.
    function canAccount() { return hasRole(['yonetici', 'muhasebe']); }
    // Tüm iş emirlerini ve dosyaları gören roller.
    function seesAll()  { return hasRole(['yonetici', 'planlamaci', 'muhasebe', 'satis']); }

    // İş emri / dosya kişinin kapsamında mı: şef departmanının tamamı,
    // personel bölümü (bölümü yoksa departmanı) ve bölümsüz kayıtlar.
    function inMyScope(d) {
      return isAllowed() && myDept() != '' && d.get('dept', '') == myDept()
          && (myRole() == 'sef' || mySection() == '' || d.get('section', '') in ['', mySection()]);
    }
    // Kendi açtığı ya da kendine atanmış iş emri.
    function mineTask(d) {
      return isAllowed()
          && (d.get('openedBy', '') == email()
              || (myPersonId() != '' && d.get('assignee', '') == myPersonId()));
    }

    // --- kimler girebilir --------------------------------------------
    // Herkes listeyi okuyabilir (ekranlarda isim göstermek için),
    // yalnızca yönetici değiştirebilir.
    match /allowed/{userEmail} {
      allow read:                   if isAllowed();
      allow create, update, delete: if isAdmin();
    }

    // --- erişim talepleri ---------------------------------------------
    // Kişi kendi talebini yalnızca bir kez bırakır: create sadece belge
    // yokken çalışır, update yalnızca yöneticide. Reddedilen bir talep
    // bu yüzden kendiliğinden tekrar açılamaz.
    // Tek belge okuma (get) ile koleksiyonu listeleme (list) ayrı tutulur:
    // listeleme yalnızca yöneticide.
    match /requests/{userEmail} {
      allow get:    if isAdmin() || (signedIn() && email() == userEmail);
      allow list:   if isAdmin();
      allow create: if signedIn()
                    && email() == userEmail
                    && !exists(userRef())
                    && request.resource.data.email == userEmail
                    && request.resource.data.status == 'bekliyor';
      allow update, delete: if isAdmin();
    }

    // --- katalog, departmanlar, personel ------------------------------
    match /config/{doc} {
      allow read:  if isAllowed();
      allow write: if isAdmin();
    }

    // --- projeler ------------------------------------------------------
    // Proje kartında gizli bilgi yok (muhasebe ayrı koleksiyonda); şef ve
    // personelin listesi uygulamada kapsamındaki iş emirlerine göre daralır.
    // Silme yalnızca yöneticide; uygulama normalde arşivler, silmez.
    match /projects/{doc} {
      allow read:           if isAllowed();
      allow create, update: if canPlan();
      allow delete:         if isAdmin();
    }

    // --- proje muhasebe bilgileri ---------------------------------------
    // Tutar, ödeme, borç-alacak: yalnızca yönetici ve muhasebe.
    match /accounting/{doc} {
      allow read, write: if canAccount();
    }

    // --- iş emirleri ----------------------------------------------------
    // Okuma: görünürlük kapsamı (yukarıda). Açma: planlayan roller her türlü
    // iş emrini; diğer herkes yalnızca proje dışı iş emrini, kendi adına.
    // Kapatma/güncelleme: planlayan roller hepsini; şef ve muhasebe kendi
    // departmanınınkini; kişiye atanmış işi o kişi; bölümüne açık, kişiye
    // atanmamış işi personel. Başka departmana iş açan kişi kapatamaz.
    match /tasks/{doc} {
      allow read:   if seesAll() || inMyScope(resource.data) || mineTask(resource.data);
      allow create: if canPlan()
                    || (isAllowed()
                        && request.resource.data.get('projectId', '') == ''
                        && request.resource.data.get('openedBy', '') == email());
      allow update: if canPlan()
                    || (hasRole(['sef', 'muhasebe']) && myDept() != ''
                        && resource.data.get('dept', '') == myDept())
                    || (isAllowed() && myPersonId() != ''
                        && resource.data.get('assignee', '') == myPersonId())
                    || (hasRole(['personel']) && inMyScope(resource.data)
                        && resource.data.get('assignee', '') == '');
      allow delete: if isAdmin();
    }

    // --- kilit özeti ------------------------------------------------------
    // Sevkiyat / Montaj / "Malzemeler geldi" kilitleri projedeki diğer iş
    // emirlerinin durumuna bakar; şef ve personel o iş emirlerini okuyamaz.
    // Her iş emri yazımı buraya küçük bir özet bırakır (ad, adım, departman,
    // durum, sipariş durumu, adet). Tutar ya da kişisel bilgi içermez.
    match /locks/{doc} {
      allow read, write: if isAllowed();
    }

    // --- iş emri dosyaları ---------------------------------------------
    // Dosya kaydı iş emrinin departman/bölümünü taşır; görünürlük aynı.
    // Dosya silinmez, yalnızca arşive alınır (archived alanı).
    match /files/{doc} {
      allow read:   if seesAll() || inMyScope(resource.data)
                    || (isAllowed() && resource.data.get('uploadedBy', '') == email());
      allow create: if isAllowed() && request.resource.data.get('uploadedBy', '') == email();
      allow update: if (canPlan() || (isAllowed() && resource.data.get('uploadedBy', '') == email()))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow delete: if false;
    }

    // --- teklifler ------------------------------------------------------
    // Fiyatlar yalnızca satış rollerine açık.
    //
    // Müşteriye giden belge değişmez: taslak olmayan (gönderilmiş, karara
    // bağlanmış, iptal ya da revize edilmiş) bir teklifte yalnızca aşağıdaki
    // alanlar değişebilir. Kalemler, fiyatlar, müşteri, KDV, iskonto ve
    // toplamlar kilitlidir; değişiklik yeni bir revizyon belgesiyle yapılır.
    function quoteRef(id) { return /databases/$(database)/documents/quotes/$(id); }
    function isDraft(d)   { return d.get('status', 'taslak') == 'taslak' && d.get('supersededBy', '') == ''; }
    function quoteMetaOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'sentAt', 'decidedAt', 'lostReason', 'notes', 'projectId',
        'supersededBy', 'updatedAt', 'updatedBy', 'updatedByName'
      ]);
    }
    match /quotes/{doc} {
      allow read:   if canSell();
      // Yeni teklif ve revizyon her zaman taslak olarak açılır.
      allow create: if canSell() && request.resource.data.status == 'taslak';
      allow update: if canSell()
                    && (isDraft(resource.data) || quoteMetaOnly())
                    // Revize bağlantısı bir kez kurulur, sonradan değiştirilemez.
                    && (resource.data.get('supersededBy', '') == ''
                        || request.resource.data.get('supersededBy', '') == resource.data.get('supersededBy', ''))
                    // Gönderilmiş teklifi yeniden düzenlemeye açmak yalnızca yöneticide.
                    && (isAdmin()
                        || resource.data.get('status', 'taslak') == 'taslak'
                        || request.resource.data.get('status', 'taslak') != 'taslak');
      // Gönderilmiş teklif silinmez, iptal edilir; satış yalnızca taslağı siler.
      allow delete: if isAdmin()
                    || (canSell() && resource.data.get('status', '') == 'taslak');
    }
    // Teklife eklenen yerleşim görseli (belge başına bir görsel).
    // Gönderilmiş teklifin görseli de belgenin parçasıdır, değişmez.
    match /quoteFiles/{doc} {
      allow read:  if canSell();
      allow write: if canSell()
                   && (isAdmin() || !exists(quoteRef(doc)) || isDraft(get(quoteRef(doc)).data));
    }
    // Teklif ayarları, ürün kataloğu ve teklif numarası sayacı.
    // "source" (fiyat listesi köprüsünün adresi ve anahtarı) bu kapsamın dışında:
    // onu yalnızca yönetici okur ve yazar.
    match /sales/{doc} {
      allow read, write: if canSell() && doc != 'source';
    }
    match /sales/source {
      allow read, write: if isAdmin();
    }

    // --- değişiklik günlüğü ---------------------------------------------
    // Salt ekleme: yazılan bir kayıt hiç kimse tarafından değiştirilemez
    // veya silinemez. "Veri kaybolmasın" güvencesi burada.
    // Kayıt başkası adına ya da geçmiş/gelecek tarihle yazılamaz: "by" giriş
    // yapan kişinin e-postası, "at" sunucu saati olmak zorunda.
    match /log/{doc} {
      allow read:   if isAllowed();
      allow create: if isAllowed()
                    && request.resource.data.keys().hasOnly(['at', 'atISO', 'by', 'byName', 'action', 'target', 'detail'])
                    && request.resource.data.by == email()
                    && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
